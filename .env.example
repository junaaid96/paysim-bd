# paysim-bd local development config. Copy to .env — never commit .env.
# Every variable is validated at boot by apps/api/src/env.ts.

NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Local Postgres (docker-compose `db` service). For Neon, paste the pooled
# connection string here — it must include ?sslmode=require.
DATABASE_URL=postgres://paysim:paysim@localhost:5432/paysim
# Database the integration tests may create tables in and TRUNCATE. CI sets this.
TEST_DATABASE_URL=postgres://paysim:paysim@localhost:5432/paysim_test
# Small pool: kind to Neon free compute and plenty for a simulator.
DB_POOL_MAX=5

# Object storage for bodies over 16 KB. `fs` = local disk (local mode only).
STORAGE_DRIVER=fs
STORAGE_FS_DIR=./data/blobs

# S3 driver (Cloudflare R2 when hosted; any S3-compatible endpoint works).
# Required when STORAGE_DRIVER=s3.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=paysim-bd
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# SSRF guard for callback/IPN delivery (enforced from Phase 2).
# true  = simulator may call localhost / private IPs (local mode).
# false = loopback, private and link-local targets are blocked (hosted mode).
# The hosted playground can NEVER reach your localhost — this is by design.
ALLOW_PRIVATE_CALLBACK_TARGETS=true

# Comma-separated extra origins for the API. Empty = reflect any origin in
# development (Vite dev server), same-origin only in production.
CORS_ORIGIN=

# Directory of the built React app served by Express. Empty = auto-detect
# ../web/dist relative to the API package (present in the hosted one-deploy).
WEB_DIST_DIR=

# Public base URL of this simulator, used for GatewayPageURL etc.
# Empty = http://localhost:PORT.
# SIM_BASE_URL=http://localhost:3001

# Neon Realtime (live activity feed). From the Realtime page in the Neon
# Console, or `neon env pull --service realtime`. Unset = the feed falls
# back to REST data. The secret stays server-side; only the URL is public.
# NEON_REALTIME_SECRET=
# NEON_REALTIME_URL=
# The dashboard also needs the same URL as VITE_NEON_REALTIME_URL in
# apps/web/.env (Vite reads env from apps/web, not the repo root).

# Encrypts the optional Real sandbox provider keys at rest (AES-256-GCM).
# Any long random string, e.g. `openssl rand -base64 32`. Unset = Real
# sandbox mode is disabled and every app stays on the simulator.
# PAYSIM_SECRETS_KEY=
