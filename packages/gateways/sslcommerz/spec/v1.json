        "https://developer.sslcommerz.com/doc/v4/",
        "https://raw.githubusercontent.com/sslcommerz/SSLCommerz-PHP/master/config/config.php"
      ],
      "notes": "Real API also accepts multipart/form-data (official PHP lib posts arrays); simulator accepts JSON + urlencoded only for now."
    },
    {
      "method": "GET",
      "path": "/validator/api/validationserverAPI.php",
      "purpose": "Order Validation by val_id",
      "implemented": true,
      "fidelity": "verified",
