  "hashRules": [
    {
      "name": "verify_sign",
      "description": "MD5 over ksort(verify_key fields + md5(store_passwd)), joined as key=value with &",
      "fidelity": "verified",
      "sources": [
        "https://raw.githubusercontent.com/sslcommerz/SSLCommerz-PHP/master/lib/SslCommerzNotification.php"
      ],
      "steps": [
        "Split verify_key on commas",
        "Take values present in the payload (missing keys skipped)",
        "Add store_passwd = md5(store password)",
        "Sort keys byte-wise (PHP ksort; identical to JS sort for ASCII keys)",
        "Join as key=value pairs with & (no trailing &)",
        "Compare md5 of the string with verify_sign (strict equality; the PHP lib uses loose ==)"
      ]
    }
  ],
  "notes": [
    "Callback transport: the doc says the user 'will redirect' to success/fail/cancel URLs while the official samples read $_POST; the simulator bridges this with an auto-submitting POST form. Mechanism docs-only.",
    "The doc's IPN example verify_sign (8070c0...) could not be reproduced: the real testbox password is unpublished, so it is an illustration, not a test vector.",
    "All datetimes are UTC; the real gateway timezone is unstated.",
    "val_id/bank_tran_id/sessionkey generations are shape-by-example only."
  ]
}
