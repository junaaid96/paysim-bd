        "https://developer.sslcommerz.com/doc/v4/",
        "https://raw.githubusercontent.com/sslcommerz/SSLCommerz-PHP/master/lib/SslCommerzNotification.php"
      ],
      "notes": "format=json only; format=xml is rejected (XML serialization not implemented)."
    },
    {
      "method": "GET",
      "path": "/gwprocess/v4/gw.php",
