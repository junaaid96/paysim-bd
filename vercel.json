{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["sin1"],
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "apps/api/drizzle/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/gwprocess/(.*)",
      "destination": "/api"
    },
    {
      "source": "/validator/(.*)",
      "destination": "/api"
    },
    {
      "source": "/v2/tokenized-checkout/(.*)",
      "destination": "/api"
    },
    {
      "source": "/bkash/(.*)",
      "destination": "/api"
    },
    {
      "source": "/remote-payment-gateway-1.0/(.*)",
      "destination": "/api"
    },
    {
      "source": "/nagad/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
